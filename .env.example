# Optional: self-hosted LanguageTool endpoint, for example http://localhost:8010/v2/check
LANGUAGETOOL_URL=

# Optional measurement IDs. Do not load them until consent has been granted.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Server-only destination for the same-origin diagnostic endpoint. Never prefix it
# with NEXT_PUBLIC_ or commit the real value. In production it must be the
# verified Redes Ordantis destination stored as a Cloudflare Worker secret.
DIAGNOSTIC_RECIPIENT=

# Public widget key. The server secret must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional webmaster verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional IndexNow submission. Generate a key; the app exposes it at /indexnow-key.txt.
INDEXNOW_KEY=
INDEXNOW_HOST=www.ordantis.com
