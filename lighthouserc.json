{
  "ci": {
    "collect": {
      "startServerCommand": "npm start -- --hostname 127.0.0.1 --port 3101",
      "startServerReadyPattern": "Ready in|started server",
      "url": [
        "http://127.0.0.1:3101/",
        "http://127.0.0.1:3101/diagnostico",
        "http://127.0.0.1:3101/capacidades/agentes-ia",
        "http://127.0.0.1:3101/govtech",
        "http://127.0.0.1:3101/research/exist-2026",
        "http://127.0.0.1:3101/insights/validar-ia-antes-de-industrializar"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "color-contrast": "error",
        "is-crawlable": "error",
        "tap-targets": "off",
        "legacy-javascript-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "unused-javascript": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci_reports"
    }
  }
}
