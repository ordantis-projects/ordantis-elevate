{
  "name": "ordantis-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "styles:demos": "tailwindcss -c quality/demos.tailwind.cjs -i components/demos/source.css -o components/demos/demos.generated.css --minify",
    "predev": "npm run styles:demos",
    "prebuild": "npm run styles:demos",
    "predev:vinext": "npm run styles:demos",
    "prebuild:vinext": "npm run styles:demos",
    "predeploy:vinext": "npm run styles:demos",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components content lib scripts tests proxy.ts next.config.ts vite.config.ts playwright.cloudflare.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:delivery": "playwright test -c playwright.delivery.config.ts",
    "test:cloudflare": "playwright test -c playwright.cloudflare.config.ts --project=desktop",
    "content:export": "node --experimental-strip-types scripts/export-content.ts",
    "quality:content": "node scripts/content-quality.mjs",
    "quality:overlap": "node --experimental-strip-types scripts/editorial-overlap.ts",
    "quality:seo": "node scripts/seo-audit.mjs",
    "quality:sources": "node --experimental-strip-types scripts/check-source-links.ts",
    "quality:language": "node scripts/languagetool.mjs",
    "quality:signsofai": "node scripts/signsofai.mjs",
    "quality:vale": "node scripts/vale.mjs",
    "quality:semantic": "node scripts/semantic-overlap.mjs",
    "quality:keywords": "node --experimental-strip-types scripts/import-keyword-planner.ts",
    "quality": "npm run content:export && npm run lint && npm run typecheck && npm run test && npm run quality:content && npm run quality:overlap && npm run quality:seo && npm run build",
    "indexnow": "node --experimental-strip-types scripts/indexnow.ts",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "lighthouse:local": "node scripts/lighthouse-local.mjs",
    "unlighthouse": "npx --yes --package=unlighthouse@0.18.0 unlighthouse-ci --site http://127.0.0.1:3000",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "build:production": "cross-env ORDANTIS_DEPLOYMENT=production vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:production": "npm run build:production && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "three": "0.184.0",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "schema-dts": "2.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "^8.2.2",
    "wrangler": "^4.135.0"
  }
}
